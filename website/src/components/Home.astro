---
import '../styles/home.css';
import LanguageSelect from './LanguageSelect.astro';
import build from '../generated/build.json';
const {locale}=Astro.props;
const zh=locale==='zh-cn';
const t=(cn:string,en:string)=>zh?cn:en;
const doc=(id='getting-started')=>`/${locale}/docs/${id}/`;
const repo='https://github.com/razeencheng/iosbackup';
const features=[
  ['CONNECT',t('USB 与 Wi-Fi 备份','USB and Wi-Fi'),t('先用 USB 完成配对与首次备份。准备好无线连接后，通过家庭网络继续备份。','Start with USB pairing and a first backup. After preparing wireless connectivity, back up over your home network.'),'wifi',t('了解连接方式','Connection guide')],
  ['SCHEDULE',t('按条件自动备份','Back up on your terms'),t('按设备设置时间窗、备份间隔、电量与充电条件，满足条件后自动发起任务。','Choose a time window, interval, battery threshold, and charging requirement for each device.'),'scheduling',t('设置备份计划','Set a schedule')],
  ['PROTECT',t('管理备份加密','Manage backup encryption'),t('开启备份加密、修改备份密码。了解不同密码的用途，另存恢复时需要的凭据。','Manage backup encryption and passwords. Keep a separate, secure copy of the credentials you need for recovery.'),'encryption',t('了解加密与密码','Encryption and passwords')],
  ['FOLLOW',t('看懂备份进行到哪一步','Know where the job stands'),t('查看任务进度与最终结果，分清等待手机授权、正在传输和连接异常。','Follow progress and the final result. See when a device needs permission or a connection needs attention.'),'states',t('读懂任务状态','Understand job states')],
  ['INSPECT',t('只读查看备份','Inspect without changing data'),t('查看备份元数据与文件清单，导出 CSV。清单查看与实际文件提取、整机恢复分别说明。','Read backup metadata and file inventories, and export CSV lists. Inspection, extraction, and device restore have distinct scopes.'),'inspection',t('了解查看范围','See inspection capabilities')],
  ['NOTIFY',t('结果按需通知','Get the updates you need'),t('配置你使用的通知渠道，了解备份结果；先发送测试通知，再观察真实事件。','Configure a notification channel for backup results. Test delivery first, then check a real event.'),'notifications',t('配置通知','Configure notifications')],
];
const faqs=[
 [t('备份会上传到第三方服务器吗？','Do my backups leave my network?'),t('设备备份写入你指定的存储位置。本地应用没有遥测或远程前端资源；只有你主动配置的通知渠道才会发送相应出站请求。','Device backups are written to storage you configure. The local app has no telemetry or remote frontend assets. Configured notification channels make their own outbound requests.')],
 [t('可以直接在 Windows 或 macOS 上运行吗？','Can it run natively on Windows or macOS?'),t('官方部署路径是 Linux / NAS 上的 Docker 容器。Windows 和 macOS 可以通过浏览器访问页面，原生运行设备备份服务不在当前支持范围内。','The supported deployment is a Linux / NAS Docker container. Windows and macOS can access the browser interface; native device backup operation is outside the current support boundary.')],
 [t('每次备份都会保留一个历史版本吗？','Does it keep every historical backup?'),t('目前会持续增量更新设备的备份集，不自动保留每次任务的独立历史版本。需要历史状态时，应另存一致副本或使用 NAS 快照；发现误删后先保护现有备份。','The current backup set is updated incrementally. Keep consistent independent copies or NAS snapshots if you need older states. After accidental deletion, protect the existing backup before running more backups.')],
 [t('备份之后，怎么恢复到 iPhone？','Can I restore a backup to an iPhone?'),t('恢复指南优先介绍 Finder 和 Apple Devices 路线；本项目备份与这些工具的兼容性仍需真机验证。站内恢复属于默认关闭的实验能力，具体范围见恢复指南。','The guide prioritizes Finder and Apple Devices. Compatibility with this project’s backups still needs device testing. In-app restore is experimental and disabled by default; see the guide for its scope.')],
];
const description=t('把 iPhone 和 iPad 备份到自己的 NAS。在浏览器里管理 USB、Wi-Fi、自动计划和备份加密。','Back up your iPhone and iPad to your own NAS. Manage USB, Wi-Fi, schedules, and backup encryption from a browser.');
---
<!doctype html>
<html lang={zh?'zh-CN':'en'}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('iOS Backup · 把备份留在自己的 NAS','iOS Backup · Backups on your own NAS')}</title><meta name="description" content={description}/><meta property="og:title" content="iOS Backup"/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={`https://iosbackup.isw.app/${locale}/`}/><link rel="canonical" href={`https://iosbackup.isw.app/${locale}/`}/><link rel="alternate" hreflang="en" href="https://iosbackup.isw.app/en/"/><link rel="alternate" hreflang="zh-CN" href="https://iosbackup.isw.app/zh-cn/"/><link rel="alternate" hreflang="x-default" href="https://iosbackup.isw.app/"/><link rel="icon" href="/assets/logo-mark.png"/>{build.mode!=='release' && <meta name="robots" content="noindex,nofollow"/>}</head>
<body>
<a class="skip" href="#main">{t('跳到正文','Skip to content')}</a>
<header class="header"><div class="wrap"><a class="brand" href={`/${locale}/`}><img src="/assets/logo-mark.png" alt="" width="42" height="42"/><span>iOS Backup</span></a><nav class="nav" id="main-nav" aria-label={t('主要导航','Main navigation')}><a href="#features">{t('功能','Features')}</a><a href={doc()}>{t('文档','Docs')}</a><a href={`${repo}/releases`}>{t('更新记录','Releases')}</a><a href={repo}>GitHub ↗</a></nav><div class="header-tools"><LanguageSelect/><a class="button small" href={doc()}>{t('开始使用','Get started')}</a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">{t('菜单','Menu')}</button></div></div></header>
<main id="main">
<section class="hero wrap"><p class="eyebrow">{t('开源 · 自托管 · 存储由你掌握','OPEN SOURCE · SELF-HOSTED · YOUR STORAGE')}</p><h1><span class="ink">{t('把 iPhone 和 iPad','Back up your iPhone and iPad.')}</span><br/><span>{t('备份到自己的 NAS。','Keep it on your own NAS.')}</span></h1><p class="lead">{t('在浏览器里管理 USB 和 Wi-Fi 备份。设置自动计划、管理备份加密，把设备备份保存在你自己的 Linux 主机或 NAS 上。','Manage USB and Wi-Fi backups from a browser. Set a schedule, manage backup encryption, and keep your data on storage you control.')}</p><div class="actions"><a class="button" href={doc()}>{t('开始使用','Get started')} <span aria-hidden="true">→</span></a><a class="button secondary" href={doc('restore')}>{t('恢复指南','Restore guide')}</a></div><p class="hero-note">{t('适用于支持 Docker 的 Linux / NAS · 无需注册项目账号','Runs on Linux / NAS with Docker · No project account required')}</p>
<figure class="product"><div class="product-bar" aria-hidden="true"><i></i><i></i><i></i><span>iOS Backup · Local console</span></div><img src="/manual-assets/docs/images/tutorial/09-usb-backup-completed.png" alt={t('群晖 NAS 上的真实控制台：设备通过 Wi-Fi 在线，一项备份显示完成','Real Synology console in Chinese: devices online over Wi-Fi and one completed backup')} width="998" height="560" fetchpriority="high"/></figure><p class="caption">{t('公开教程中的真实界面 · 截图版本 v1.5.2 · 备份完成不代表已经验证可恢复','Real interface from the public tutorial · Captured on v1.5.2, Chinese UI · Backup completion does not verify restoration')}</p>
<div class="proof"><span><b class="dot">●</b> {t('备份保存在本地','Stored locally')}</span><span>USB + Wi-Fi</span><span>{t('本地应用无遥测','No telemetry in the local app')}</span><span>AGPL-3.0-only</span></div></section>
<section id="features" class="section wrap"><div class="section-head"><div><p class="section-kicker">{t('日常备份','EVERYDAY BACKUP')}</p><h2>{t('备份有计划，进度看得见。','A backup routine you can see.')}</h2></div><p>{t('连接设备、设置条件、查看结果。在一个本地控制台里，管理家中的设备备份。','Connect your device, choose your conditions, and see the result from one local console.')}</p></div><div class="features">{features.map(([tag,title,body,id,label],i)=><article class="feature"><span class="feature-number">{String(i+1).padStart(2,'0')} / {tag}</span><h3>{title}</h3><p>{body}</p><a href={doc(id)}>{label} →</a></article>)}</div></section>
<section class="section tint"><div class="wrap"><div class="section-head"><div><p class="section-kicker">{t('开始使用','YOUR FIRST BACKUP')}</p><h2>{t('先完成一次完整备份。','Start with one complete backup.')}</h2></div><a href={doc()}>{t('打开入门指南','Open the getting-started guide')} →</a></div><div class="steps"><article class="step"><h3>{t('准备你的 NAS','Prepare your NAS')}</h3><p>{t('选择群晖或 Linux 安装指南，准备持久化存储目录并启动容器。','Choose the Synology or Linux guide. Set up persistent storage and start the container.')}</p><a href={doc('synology')}>{t('群晖安装','Synology')} →</a> · <a href={doc('installation')}>Linux →</a></article><article class="step"><h3>{t('连接并配对设备','Connect and pair')}</h3><p>{t('用 USB 数据线连接 iPhone / iPad，按手机提示输入密码或确认信任。','Connect a USB data cable and follow the permission prompts on your iPhone or iPad.')}</p><a href={doc('usb-backup')}>{t('首次 USB 备份','Your first USB backup')} →</a></article><article class="step"><h3>{t('备份并核对结果','Back up, then verify')}</h3><p>{t('完成首次 USB 备份并核对结果，再逐项配置 Wi-Fi 和自动计划。','Complete your first USB backup and check the result before setting up Wi-Fi and schedules.')}</p><a href={doc('restore')}>{t('也了解一下恢复方式','Understand your restore options')} →</a></article></div><p class="small-note">{t('自动备份会在条件满足时发起；iOS 仍可能要求输入锁屏密码。备份完成不等于已经验证可以恢复。','Automatic backups start when conditions are met. iOS may still require the passcode. A completed backup is not proof of a successful restore.')}</p></div></section>
<section class="section wrap"><div class="requirements"><div><p class="section-kicker">{t('部署前确认','BEFORE YOU INSTALL')}</p><h2>{t('给备份准备一个可靠的家。','A home for your backups.')}</h2><p class="intro">{t('iOS Backup 运行在你管理的可信主机上。你决定备份的存储位置，也负责设备连接和访问权限。','iOS Backup runs on a trusted host you manage. You choose the storage location and manage device connectivity and access.')}</p><p style="margin-top:24px"><a href={doc('overview')}>{t('环境与支持范围','Requirements and support boundaries')} →</a></p></div><dl class="spec-list">{[
[t('运行环境','Host'),t('Linux / 兼容 NAS · Docker','Linux / compatible NAS · Docker')],
[t('镜像架构','Architecture'),'amd64 / arm64'],
[t('首次连接','Connection'),t('USB 数据线与可解锁的设备','USB data cable and an unlockable device')],
[t('存储空间','Storage'),t('完整设备备份所需空间，并预留余量','Space for a complete backup, plus headroom')],
[t('访问边界','Access'),t('可信主机与受限网络；容器需要特权模式','Trusted host and network; privileged container')]
].map(([key,value])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl></div><div class="recovery"><div><p class="section-kicker">{t('需要恢复时','WHEN YOU NEED YOUR DATA BACK')}</p><h3>{t('手机丢了，或数据误删了，下一步怎么做？','A lost phone. An accidental deletion. What next?')}</h3><p>{t('先看恢复总览：该保留哪份备份、目标设备需要满足什么条件，以及哪些恢复路径仍待验证。','Start with which backup to keep, what the target device needs, and which restore paths still need verification.')}</p></div><a class="button secondary" href={doc('restore')}>{t('阅读恢复指南','Read restore guide')} →</a></div></section>
<section class="section tint"><div class="wrap faq"><p class="section-kicker">{t('常见问题','COMMON QUESTIONS')}</p><h2>{t('开始之前，你可能想知道。','A few things to know first.')}</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
<section class="closing wrap"><div><h2>{t('从自己的第一份备份开始。','Make room for your first backup.')}</h2><p>{t('选一条适合你的安装路线，跟着指南逐步完成。','Pick the guide for your host and follow it one step at a time.')}</p></div><a class="button" href={doc()}>{t('开始使用','Get started')} →</a></section>
</main>
<footer class="footer"><div class="wrap"><div class="footer-top"><div><a class="brand" href={`/${locale}/`}><img src="/assets/logo-mark.png" alt="" width="34" height="34"/>iOS Backup</a><p>{t('家庭 iPhone 与 iPad 的本地优先备份。','Local-first backups for your family’s iPhone and iPad.')}</p><p>{build.productVersion} · {build.mode==='release'?t('公开发布文档','Released documentation'):t('本地预览 · 尚未发布','Local preview · not published')}</p></div><div class="footer-column"><strong>{t('项目','Project')}</strong><a href={repo}>GitHub</a><a href={`${repo}/releases`}>{t('更新记录','Release notes')}</a><a href={`${repo}/blob/main/CONTRIBUTING.md`}>{t('参与贡献','Contribute')}</a><a href={`${repo}/issues/new/choose`}>{t('问题反馈','Report an issue')}</a></div><div class="footer-column"><strong>{t('支持与信任','Support & trust')}</strong><a href={`${repo}/blob/main/SUPPORT.md`}>{t('支持范围','Support policy')}</a><a href={`${repo}/blob/main/SECURITY.md`}>{t('安全报告','Report a vulnerability')}</a><a href={`${repo}/blob/main/docs/PRIVACY.md`}>{t('隐私说明','Privacy')}</a><a href={`${repo}/blob/main/LICENSE`}>AGPL-3.0-only</a></div></div><div class="footer-bottom"><span>iOS Backup · AGPL-3.0-only</span><span>{t('独立开源项目，与 Apple Inc. 无隶属或背书关系。','Independent open-source project. Not affiliated with or endorsed by Apple Inc.')}</span></div></div></footer>
<script>
const button=document.querySelector<HTMLButtonElement>('.menu-toggle');
button?.addEventListener('click',()=>{const expanded=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(expanded));document.querySelector('.nav')?.classList.toggle('open',expanded)});
document.querySelector('.nav')?.addEventListener('click',()=>{button?.setAttribute('aria-expanded','false');document.querySelector('.nav')?.classList.remove('open')});
document.addEventListener('keydown',e=>{if(e.key==='Escape' && button?.getAttribute('aria-expanded')==='true'){button.setAttribute('aria-expanded','false');document.querySelector('.nav')?.classList.remove('open');button.focus()}});
</script>
</body></html>
