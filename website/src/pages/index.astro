import build from '../generated/build.json';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>iOS Backup</title><link rel="canonical" href="https://iosbackup.isw.app/"/>{build.mode!=='release' && <meta name="robots" content="noindex,nofollow"/>}<link rel="alternate" hreflang="en" href="https://iosbackup.isw.app/en/"/><link rel="alternate" hreflang="zh-CN" href="https://iosbackup.isw.app/zh-cn/"/></head><body><main><img src="/assets/logo-mark.png" alt="" width="64" height="64"/><h1>iOS Backup</h1><p>Back up your iPhone and iPad to your own NAS.</p><p><a href="/en/" data-language="en">English →</a>　<a href="/zh-cn/" lang="zh-CN" data-language="zh-cn">简体中文 →</a></p></main><script is:inline>
let preferred;try{preferred=localStorage.getItem('iosbackup-site-language')}catch{}
const locale=['en','zh-cn'].includes(preferred)?preferred:((navigator.languages?.[0]||navigator.language||'en').toLowerCase().startsWith('zh')?'zh-cn':'en');
location.replace('/'+locale+'/');
</script></body></html>
<style>body{font:18px system-ui;background:#f5f7f8;color:#182430;display:grid;place-items:center;min-height:90vh}main{text-align:center;padding:24px}a{color:#2c62c6}</style>
