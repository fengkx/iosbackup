{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iosbackup-site",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "iosbackup.isw.app", "custom_domain": true }]
}
